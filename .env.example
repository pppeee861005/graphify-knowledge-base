# .env.example - 配置模板（复制本文件为 .env，然后填入实际密钥）
# 此文件展示需要的环境变量，但不包含实际密钥值

# ===== Perplexity API =====
PERPLEXITY_API_KEY=your_actual_key_here

# ===== Kling AI Keys =====
KLING_ACCESS_KEY=your_actual_key_here
KLING_SECRET_KEY=your_actual_key_here

# ===== VPS SSH (可选，仅用于本地开发) =====
# 推荐：改用 SSH Key 认证而非密码
VPS_HOST=198.13.46.158
VPS_USER=root
# VPS_PASSWORD=不要硬编码！改用系统密钥管理器

# ===== 其他配置 =====
# 按需添加其他环境变量
