# 法幣退潮監測 - API 憑證配置模板
#
# 使用說明：
# 1. 複製此文件並重名為 credentials.env
# 2. 填入你的 API key
# 3. 將 credentials.env 添加到 .gitignore（不要提交到版本控制）
#
# ⚠️ 安全提醒：
# - 絕不要將含有真實 API key 的文件提交到 Git
# - 在生產環境使用密鑰管理工具（如 AWS Secrets Manager）
#

# ============================================================================
# Alpha Vantage - 美元指數(DXY)數據
# ============================================================================
# 申請地址：https://www.alphavantage.co/
# 免費額度：每分鐘 5 個調用，每天 500 個調用
# 高級版本：每分鐘 500 個調用
#
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ============================================================================
# Metals-API - 黃金、白銀價格數據
# ============================================================================
# 申請地址：https://metals-api.com/
# 免費額度：每天 100 個請求
# 高級版本：無限制
#
METALS_API_KEY=your_metals_api_key_here

# ============================================================================
# NewsAPI - 政策新聞監測
# ============================================================================
# 申請地址：https://newsapi.org/
# 免費額度：每天 100 個請求
# 高級版本：更多請求額度
#
NEWSAPI_KEY=your_newsapi_key_here

# ============================================================================
# Coinbase Pro API - 加密貨幣價格（可選）
# ============================================================================
# 申請地址：https://developers.coinbase.com/
# 公開端點無需認證，但認證端點需要 API key
#
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here
COINBASE_PASSPHRASE=your_coinbase_passphrase_here

# ============================================================================
# COMEX/LBMA 數據來源
# ============================================================================
# COMEX 庫存數據：https://www.cmegroup.com/reports/inventory
# LBMA 庫存數據：https://www.lbma.org.uk/silver-data-centre
#
# 這些數據是公開的，但可能需要 Web 爬蟲或付費數據聚合服務
# 可考慮的服務：
# - Quandl (https://www.quandl.com/) - 付費
# - Trading View API - 付費
#
# 如使用 Quandl：
QUANDL_API_KEY=your_quandl_api_key_here

# ============================================================================
# Reuters/Bloomberg API（可選）
# ============================================================================
# 用於新聞監測（高級用戶）
#
BLOOMBERG_API_KEY=your_bloomberg_api_key_here

# ============================================================================
# 本地經銷商數據收集（手動）
# ============================================================================
# 用於實物溢價調查，無需 API key
# 在執行月度監測時手動輸入
#
LOCAL_DEALER_1_NAME=Local Jewelry Store A
LOCAL_DEALER_1_CONTACT=contact info
LOCAL_DEALER_2_NAME=Local Jewelry Store B
LOCAL_DEALER_2_CONTACT=contact info

# ============================================================================
# 數據庫配置（可選，用於存儲歷史數據）
# ============================================================================
# 如使用本地數據庫存儲時間序列數據
#
DATABASE_TYPE=sqlite  # 或 postgresql, mysql
DATABASE_URL=sqlite:///./monitoring_data.db

# ============================================================================
# 郵件通知配置（可選）
# ============================================================================
# 用於異常預警時發送郵件通知
#
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
NOTIFICATION_EMAIL=recipient@example.com

# ============================================================================
# Slack 通知配置（可選）
# ============================================================================
# 用於異常預警時發送 Slack 消息
#
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# 日誌配置
# ============================================================================
# 調試級別：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/fiat_tide_monitoring.log

# ============================================================================
# 環境標識
# ============================================================================
# 用於區分開發、測試和生產環境
ENVIRONMENT=development  # 或 testing, production
